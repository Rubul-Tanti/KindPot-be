generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String             @id @default(uuid())
  publicId                  String             @unique @default(uuid())
  email                     String             @unique
  password                  String?
  role                      UserRole           @default(VIEWER)
  authProvider              AuthProvider       @default(EMAIL)
  googleId                  String?
  resetPasswordToken        String?            @unique
  resetPasswordTokenExpires DateTime?
  twoFactorSecret           String?
  twoFactorEnabled          Boolean            @default(false)
  profilePicture            String?
  userName                  String
  firstName                 String?
  lastName                  String?
  phoneNumber               String?
  dateOfBirth               DateTime?
  lastLoginAt               DateTime?
  lastLoginIp               String?
  loginAttempts             Int                @default(0)
  lockedUntil               DateTime?
  isActive                  Boolean            @default(true)
  deletedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  draws                     Draw[]
  participants              Participant[]
  winners                   Winner[]
  scores                    GolfScore[]
  subcriptions              SubscriptionOrder?
  userCharities             UserCharity[]

  @@index([email])
  @@index([publicId])
  @@index([role])
  @@index([deletedAt])
}

model Otp {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Charity {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  logoUrl       String?
  websiteUrl    String?
  isFeatured    Boolean        @default(false)
  isActive      Boolean        @default(true)
  country       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        CharityImage[]
  userCharities UserCharity[]

  @@map("charities")
}

model CharityImage {
  id        String   @id @default(cuid())
  charityId String
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)

  @@map("charity_images")
}

model UserCharity {
  id             String                  @id @default(cuid())
  userId         String
  charityId      String
  subscriptionId String                  @unique
  type           CharityContributionType
  percentage     Decimal?                @db.Decimal(5, 2)
  amount         Decimal                 @db.Decimal(10, 2)
  currency       String                  @default("GBP")
  month          Int?
  year           Int?
  status         CharityStatus           @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  charity        Charity                 @relation(fields: [charityId], references: [id])
  subscription   SubscriptionOrder       @relation(fields: [subscriptionId], references: [id])
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year, type])
  @@index([charityId, month, year, status])
  @@map("user_charities")
}

model GolfScore {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  playedOn  DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playedOn])
  @@map("golf_scores")
}

model SubscriptionModel {
  id                 String              @id @default(uuid())
  planName           String
  planDescription    String?
  price              Int
  currency           String
  features           String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subscriptionOrders SubscriptionOrder[]
}

model SubscriptionOrder {
  id                    String            @id @default(uuid())
  subscriptionModelId   String
  userId                String            @unique
  periodStart           DateTime
  periodEnd             DateTime
  stripeSessionId       String?           @unique
  stripePaymentIntentId String?           @unique
  stripeCustomerId      String?
  stripeClientSecret    String?           @unique
  stripeEventId         String?           @unique
  paymentGateway        PaymentGateway    @default(STRIPE)
  amount                Int
  currency              String            @default("GBP") @db.Char(3)
  status                PaymentStatus     @default(PENDING)
  failReason            String?
  completedAt           DateTime?
  cancelledAt           DateTime?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  subscriptionModel     SubscriptionModel @relation(fields: [subscriptionModelId], references: [id])
  user                  User              @relation(fields: [userId], references: [id])
  userCharities         UserCharity?

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([periodStart, periodEnd])
  @@map("subscription_orders")
}

model Draw {
  id                String        @id @default(uuid())
  adminId           String
  prizePool         Int
  currency          String        @default("USD")
  entryStartDate    DateTime
  lastEntryDate     DateTime
  resultDate        DateTime
  drawNumber        String?       @unique
  status            DrawStatus    @default(active)
  fiveMatchPct      Int           @default(40)
  fourMatchPct      Int           @default(35)
  threeMatchPct     Int           @default(25)
  jackpotRolledOver Boolean       @default(false)
  rolledOverFromId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  admin             User          @relation(fields: [adminId], references: [id])
  rolledOverFrom    Draw?         @relation("JackpotRollover", fields: [rolledOverFromId], references: [id])
  rolledOverTo      Draw[]        @relation("JackpotRollover")
  participants      Participant[]
  winners           Winner[]
}

model Winner {
  id                 String              @id @default(uuid())
  drawId             String
  userId             String
  winnerType         WinnerType
  winnerScore        String
  verificationStatus VerificationStatus  @default(pending)
  paymentStatus      WinnerPaymentStatus @default(pending)
  proofImage         String?
  prizeAmount        Int?
  adminNotes         String?
  verifiedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  draw               Draw                @relation(fields: [drawId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
}

model Participant {
  id        String   @id @default(uuid())
  drawId    String
  userId    String
  score     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  draw      Draw     @relation(fields: [drawId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([drawId, userId])
  @@index([drawId])
  @@index([userId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PaymentGateway {
  STRIPE
  MANUAL
}

enum UserRole {
  VIEWER
  ADMIN
  SUBSCRIBER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum CharityContributionType {
  SUBSCRIPTION_PERCENTAGE
  INDEPENDENT_DONATION
}

enum CharityStatus {
  PENDING
  PAID
}

enum DrawStatus {
  active
  completed
  cancelled
}

enum WinnerType {
  fiveMatch
  fourMatch
  threeMatch
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum WinnerPaymentStatus {
  pending
  paid
  failed
}
